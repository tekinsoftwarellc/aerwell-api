# Aerwell API environment — dev box (i-08b21c52d96827f7d), /home/ubuntu/aerwell-api/.env (chmod 600).
# Values below are real non-secret settings for Aerwell dev. Lines marked <SECRET> or <FILL> must be
# replaced. A blank KEY= line means "unset". Never commit the real .env.

# --- Runtime ---
NODE_ENV=production
PORT=3003
HOST=0.0.0.0

# --- Database (Atlas user aerwell_api_svc, readWrite on db "aerwell" only) ---
MONGODB_URI=mongodb+srv://aerwell_api_svc:<SECRET>@<FILL cluster host>/aerwell?retryWrites=true&w=majority&appName=aerwell-api

# --- Admin origin (CloudFront) ---
CORS_ORIGIN=https://d2p9e00qusbm7d.cloudfront.net
ADMIN_BASE_URL=https://d2p9e00qusbm7d.cloudfront.net

# --- Rate limit (per IP, per window) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000

# --- Staff auth (Aerwell-owned) ---
# openssl rand -base64 48   (min 32 chars; different per environment)
STAFF_JWT_SECRET=<SECRET>
# Pick once, never change: node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
AERWELL_ORG_ID=<FILL 24-hex id>

# --- AWS: access key of IAM user aerwell (infra/aerwell-user-policy.json) ---
AWS_ACCESS_KEY_ID=<SECRET>
AWS_SECRET_ACCESS_KEY=<SECRET>
AWS_REGION=us-east-1
AWS_S3_BUCKET=aerwell-api-dev-uploads-585239386213-us-east-1
# Verified SES identity (email or domain) in us-east-1
SES_FROM_EMAIL=<FILL e.g. no-reply@aerwell.com>

# --- Visit transcription + AI (AWS only, us. inference profiles) ---
TRANSCRIBE_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_SMART=us.anthropic.claude-sonnet-5

# --- Payments: stay unconfigured (PAYMENTS_UNCONFIGURED) until all three are set ---
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Alfred integration: off. Leave unset. ---
# When enabled, both auth and API traffic use the merged Alfred API origin.
# Preserve these variable names, client credentials, scopes, and token issuer.
# ALFRED_API_INTERNAL_URL=
# ALFRED_AUTH_URL=
# ALFRED_AUTH_JWKS_URL=
# ALFRED_AUTH_CLIENT_ID=
# ALFRED_AUTH_CLIENT_SECRET=
# Enabled origins: ALFRED_API_INTERNAL_URL / ALFRED_AUTH_URL = https://api-alfred.tekinsoftware.com
# Enabled JWKS: ALFRED_AUTH_JWKS_URL = https://api-alfred.tekinsoftware.com/.well-known/jwks.json

# --- First super admin: set, run `npm run seed:dist` once, then DELETE these lines ---
# SEED_SUPER_ADMIN_EMAIL=
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_SUPER_ADMIN_FIRST_NAME=
# SEED_SUPER_ADMIN_LAST_NAME=

# D1 Alfred partner contract (/api/v1/alfred). Off in production unless PARTNER_CONTRACT_ENABLED=true,
# which then requires ALFRED_PARTNER_ORG_ID, ALFRED_AUTH_JWKS_URL and AERWELL_ORG_ID.
# PARTNER_CONTRACT_ENABLED=
# ALFRED_PARTNER_AUDIENCE=partner-aerwell
# ALFRED_PARTNER_ORG_ID=
# ALFRED_API_URL=https://api-alfred.tekinsoftware.com
# PARTNER_OUTBOX_ENABLED=
# PARTNER_OUTBOX_INTERVAL_MS=5000
# PARTNER_OUTBOX_BATCH_SIZE=50
# PARTNER_OUTBOX_MAX_ATTEMPTS=12
# PARTNER_OUTBOX_PUBLISH_TIMEOUT_MS=5000

# --- Public origin of this API (catalog image URLs sent to Alfred). Blank = no media. ---
PUBLIC_API_URL=https://api-aerwell.tekinsoftware.com
