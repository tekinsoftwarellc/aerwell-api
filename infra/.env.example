# Copy to infra/.env (git-ignored); tf.py loads it. Shell values win over the file.
# Same values as aerwell-admin/infra/.env. Never put access keys here; use the profile.
AWS_PROFILE=alfred-infra
TF_VAR_github_connection_arn=arn:aws:codestar-connections:us-east-1:585239386213:connection/REPLACE_ME
