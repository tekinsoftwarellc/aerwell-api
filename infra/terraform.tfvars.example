# Copy to terraform.tfvars (git-ignored). The GitHub connection ARN comes from
# infra/.env (TF_VAR_github_connection_arn) through tf.py; do not put it here.
aws_region        = "us-east-1"
project_name      = "aerwell-api"
github_repository = "tekinsoftwarellc/aerwell-api"

environments = {
  dev = {
    branch                = "dev"
    instance_id           = "i-08b21c52d96827f7d" # shared Everhaus dev box
    instance_profile_name = "EC2-WITH-CODE-PIPELINE"
    # instance_role_name  = "EC2-WITH-CODE-PIPELINE" # role inside the profile; defaults to the profile name
    deploy_tag_key   = "CodeDeploy"
    deploy_tag_value = "everhaus-api-dev"
    admin_origin     = "https://d2p9e00qusbm7d.cloudfront.net"
  }
}
